# Only Final_project and the files cloud sessions need are published.
# Everything else in the Final Project folder (course PDF, notes, test files)
# stays local.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/Final_project/
!/scripts/
!/.github/
!/.claude/
# Personal Claude Code settings stay local
/.claude/settings.local.json

# Safety net for anything generated inside Final_project
__pycache__/
.venv/
node_modules/
.env
.env.local
*.db
.coverage
.pytest_cache/
.ruff_cache/
*.db-shm
*.db-wal
.e2e/
.chroma/
chroma/
.next/
.vercel/
coverage/
test-results/
playwright-report/
